<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WorkflowCoreProject Condition="'$(WorkflowCoreProject)' == ''">../Core/LiveryStudio.Core.csproj</WorkflowCoreProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../App/GameWorkflow.cs" Link="GameWorkflow.cs" />
    <Compile Include="../App/InstalledLibrary.cs" Link="InstalledLibrary.cs" />
    <Compile Include="../App/DraftRecovery.cs" Link="DraftRecovery.cs" />
    <Compile Include="../App/ProjectFiles.cs" Link="ProjectFiles.cs" />
    <ProjectReference Include="$(WorkflowCoreProject)" />
  </ItemGroup>
</Project>
