     <Grid><TextBlock Text="Height stretch"/><TextBlock Text="{Binding ElementName=ToolHeightScale,Path=Value,Converter={StaticResource Percent}}" HorizontalAlignment="Right"/></Grid><Slider x:Name="ToolHeightScale" Minimum="0.1" Maximum="5" Value="1" StepFrequency="0.05" ValueChanged="SettingsChanged"/>
     <CheckBox x:Name="ToolFlipHorizontal" Content="Flip artwork horizontally" Click="ProjectionOptionsChanged"/><CheckBox x:Name="ToolFlipVertical" Content="Flip artwork vertically" Click="ProjectionOptionsChanged"/>
     <ComboBox x:Name="ToolAlignment" Header="Align decal with" SelectedIndex="0" SelectionChanged="ToolProjectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="Surface · follows the body"/><ComboBoxItem Content="Camera · straight stripes"/></ComboBox>
     <ComboBox x:Name="ToolWrapPreset" Header="Wrap preset" SelectedIndex="1" SelectionChanged="WrapPresetChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="Flat logo"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Wrap a corner"/><ComboBoxItem Content="Long stripe"/></ComboBox>
     <NumberBox x:Name="ToolWrapAngle" Header="Wrap around bends · degrees" Minimum="1" Maximum="89" Value="75.52249" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="ToolWrapValueChanged"/>
     <NumberBox x:Name="ToolWrapDepth" Header="Reach nearby panels · × decal size" Minimum="0.01" Maximum="2" Value="0.35" SmallChange="0.05" SpinButtonPlacementMode="Compact" ValueChanged="ToolWrapValueChanged"/>
