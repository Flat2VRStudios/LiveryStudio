     <Button Content="Paint the car" Click="BeginnerPaint" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/>
     <Button Content="Add a PNG sticker…" Click="BeginnerSticker" HorizontalAlignment="Stretch"/>
     <Button Content="Change car color…" Click="BeginnerBodyColor" HorizontalAlignment="Stretch"/>
     <TextBlock Text="Your draft saves automatically. Save project keeps a portable copy." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource StudioSecondaryTextBrush}"/>
    </StackPanel>
    <StackPanel x:Name="MaskBrushSettings" Visibility="Collapsed" Spacing="10"><ComboBox x:Name="MaskBrushAction" Header="Brush action" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="Erase selected decal"/><ComboBoxItem Content="Restore original artwork"/></ComboBox><Button Content="Finish editing this decal" Click="SelectArtwork" HorizontalAlignment="Stretch"/><TextBlock Text="All copies in this layer share the change. Restore reveals the original image, including areas hidden by an earlier stencil." FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
