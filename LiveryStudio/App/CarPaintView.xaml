    </StackPanel></Expander>
    <StackPanel x:Name="BrushEdgeSettings" Spacing="10"><Grid><TextBlock Text="Brush hardness"/><TextBlock Text="{Binding ElementName=BrushHardness,Path=Value,Converter={StaticResource Percent}}" HorizontalAlignment="Right"/></Grid><Slider x:Name="BrushHardness" Minimum="0" Maximum="1" Value="0.85" StepFrequency="0.01"/></StackPanel>
    <CheckBox x:Name="MirrorPaint" Content="Mirror across the car" Click="ProjectionOptionsChanged" ToolTipService.ToolTip="Place the same artwork on the opposite side. Lettering stays readable."/>
    <CheckBox x:Name="ProtectSharedParts" Content="Protect shared parts" IsChecked="True" Click="ProjectionOptionsChanged" ToolTipService.ToolTip="Avoid changing linked parts of the car. Turn this off to paint those parts together."/>
    <Button Content="Make sides independent…" Click="RequestIndependentSides"/>
    <TextBlock x:Name="BeginnerPairHelp" Text="Both sides adds matching, readable artwork to the opposite door. Leave it off to decorate each side separately." TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}"/>
    <Expander x:Name="SurfaceSeamSettings" Header="Surface &amp; seams" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10">
