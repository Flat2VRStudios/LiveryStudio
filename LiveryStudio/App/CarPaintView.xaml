      <Slider x:Name="PatternTransition" Header="Gradient transition" Minimum="0.05" Maximum="0.95" Value="0.5" ValueChanged="PatternSliderChanged" AutomationProperties.Name="Gradient transition"/>
      <StackPanel x:Name="PatternRadialFields" Spacing="10" Visibility="Collapsed"><TextBlock Text="Center across"/><Slider x:Name="PatternCenterX" Minimum="0" Maximum="1" Value="0.5" ValueChanged="PatternSliderChanged" AutomationProperties.Name="Radial gradient center across"/><TextBlock Text="Center down"/><Slider x:Name="PatternCenterY" Minimum="0" Maximum="1" Value="0.5" ValueChanged="PatternSliderChanged" AutomationProperties.Name="Radial gradient center down"/><TextBlock Text="Gradient radius"/><Slider x:Name="PatternRadius" Minimum="0.05" Maximum="2" Value="0.6" ValueChanged="PatternSliderChanged" AutomationProperties.Name="Radial gradient radius"/></StackPanel>
      <TextBlock Text="First color opacity"/><Slider x:Name="PatternAlphaA" Minimum="0" Maximum="1" Value="1" ValueChanged="PatternSliderChanged" AutomationProperties.Name="Pattern first color opacity"/><TextBlock Text="Second color opacity"/><Slider x:Name="PatternAlphaB" Minimum="0" Maximum="1" Value="1" ValueChanged="PatternSliderChanged" AutomationProperties.Name="Pattern second color opacity"/>
      <TextBlock Text="Soften the outside edges"/><Slider x:Name="PatternEdgeFade" Minimum="0" Maximum="0.5" Value="0" ValueChanged="PatternSliderChanged" AutomationProperties.Name="Pattern edge fade"/>
      <NumberBox x:Name="PatternAspect" Header="Width / height" Minimum="0.25" Maximum="4" Value="2" ValueChanged="PatternNumberChanged" SpinButtonPlacementMode="Compact"/>
      <ComboBox x:Name="PatternResolution" Header="Artwork resolution" SelectedIndex="1" SelectionChanged="PatternChoiceChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="512 pixels"/><ComboBoxItem Content="1024 pixels"/><ComboBoxItem Content="2048 pixels"/></ComboBox>
      <TextBlock Text="More repeats make smaller details. After placement, use stretch, wrap and layer opacity to fit the design to the panel." FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}" TextWrapping="Wrap"/>
     </StackPanel></Expander>
    </StackPanel></Expander>
    <Button Content="Add PNG or SVG artwork" Click="ImportArtworkFile" HorizontalAlignment="Stretch"/>
    <ComboBox x:Name="ShapeSelector" Header="Create a shape" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="Circle"/><ComboBoxItem Content="Ring"/><ComboBoxItem Content="Chevron"/><ComboBoxItem Content="Racing stripe"/><ComboBoxItem Content="Number"/></ComboBox><TextBox x:Name="RacingNumber" Header="Racing number" Text="27" MaxLength="3"/><Button Content="Create &amp; use shape" Click="CreateShape" HorizontalAlignment="Stretch"/><TextBlock Text="Shapes use the brush color. Generated artwork joins your reusable library." FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}" TextWrapping="Wrap"/>
    <ComboBox x:Name="PaletteSelector" Header="Color palette" DisplayMemberPath="Name" SelectionChanged="PaletteSelected" HorizontalAlignment="Stretch"/><ComboBox x:Name="PaletteColor" Header="Palette color" SelectionChanged="PaletteColorSelected" HorizontalAlignment="Stretch"/><Button Content="Save this paint palette" Click="SavePalette" HorizontalAlignment="Stretch"/>
    <TextBlock Text="REUSABLE GROUPS" Foreground="{ThemeResource StudioAccentTextBrush}" FontSize="10"/><ComboBox x:Name="GroupLibrary" Header="Saved editable artwork" DisplayMemberPath="Name" SelectionChanged="ReusableGroupChosen" HorizontalAlignment="Stretch"/><Button x:Name="UseGroupButton" IsEnabled="False" Content="Place saved artwork on the car" Click="UseArtworkGroup" HorizontalAlignment="Stretch"/>
    <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Import artwork" Click="ImportArtworkGroup" HorizontalAlignment="Stretch"/><Button x:Name="ExportGroupButton" IsEnabled="False" Content="Export artwork" Click="ExportArtworkGroup" Grid.Column="1" HorizontalAlignment="Stretch"/></Grid>
    <TextBlock Text="Groups retain text, shapes and finish layers. Save a selection in Layers &amp; history, or import a portable .flart file." FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}" TextWrapping="Wrap"/>
    <TextBlock Text="DESIGN TEMPLATES" FontSize="10" Foreground="{ThemeResource StudioAccentTextBrush}" Margin="0,8,0,0"/><Button Content="Save current design as a template" Click="SaveDesignTemplate" HorizontalAlignment="Stretch"/><ComboBox x:Name="TemplateList" Header="Saved design templates" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/><Button Content="Open selected template" Click="OpenDesignTemplate" HorizontalAlignment="Stretch"/>
   </StackPanel></ScrollViewer>
   <ScrollViewer x:Name="ColorsInspector" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
    <TextBlock Text="DESIGN COLORS" FontSize="10" Foreground="{ThemeResource StudioAccentTextBrush}"/><TextBlock x:Name="DesignColorsStatus" TextWrapping="Wrap" FontSize="12"/><Button Content="Refresh design colors" Click="RefreshDesignColorsClicked" HorizontalAlignment="Stretch"/>
    <TextBlock Text="SHARED COLORS" FontSize="10" Foreground="{ThemeResource StudioAccentTextBrush}"/><TextBlock x:Name="SharedColorsEmpty" Text="Link a color below, give it a name, then change its matching fields together." TextWrapping="Wrap" FontSize="12"/><StackPanel x:Name="SharedColorCards" Spacing="12"/>
    <TextBlock Text="COLORS IN THIS DESIGN" FontSize="10" Foreground="{ThemeResource StudioAccentTextBrush}"/><Grid x:Name="DesignColorTiles" RowSpacing="6" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid>
    <TextBlock Text="Image swatches show common source colors. Exact pixel recoloring keeps transparency. New brush, text, pattern and SVG fields with one matching shared color join it automatically. Editing a linked field by itself makes that field independent." TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}"/>
   </StackPanel></ScrollViewer>
  </Grid></Grid></Border>
  <Button x:Name="InspectorToggle" Visibility="Collapsed" Content="Studio tools" Click="ToggleInspector" AutomationProperties.Name="Painting, layers, materials, lighting and artwork tools" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"/>
  <Border x:Name="ImageReviewBar" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{ThemeResource StudioCardBrush}" BorderBrush="{ThemeResource StudioBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,8,0,0">
   <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ImageReviewCaption" Text="Prepared preview" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource StudioAccentTextBrush}" TextTrimming="CharacterEllipsis"/>
     <ToggleButton x:Name="ImageReviewSaved" Grid.Column="1" Content="Saved design" Checked="ImageReviewComparisonChanged" Unchecked="ImageReviewComparisonChanged" AutomationProperties.Name="Compare with saved design" ToolTipService.ToolTip="Toggle between your saved design and the prepared preview"/>
     <Button Grid.Column="2" Content="Camera" AutomationProperties.Name="Image preview camera"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Focus decal" Click="FocusPreparedImage"/><MenuFlyoutItem Text="Whole car" Click="FitCar"/><MenuFlyoutItem Text="Top" Tag="top" Click="Preset"/><MenuFlyoutItem Text="Front" Tag="front" Click="Preset"/><MenuFlyoutItem Text="Left" Tag="left" Click="Preset"/><MenuFlyoutItem Text="Right" Tag="right" Click="Preset"/><MenuFlyoutItem Text="Three-quarter" Tag="reset" Click="Preset"/></MenuFlyout></Button.Flyout></Button>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button x:Name="ImageReviewBack" Content="Back to settings" Click="ImageReviewBackClicked" HorizontalAlignment="Stretch"/>
     <Button x:Name="ImageReviewApply" Grid.Column="1" Content="Apply prepared image" Click="ImageReviewApplyClicked" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/>
     <Button Grid.Column="2" Content="Cancel" Click="ImageReviewCancelClicked" AutomationProperties.Name="Cancel image preparation" HorizontalAlignment="Stretch"/>
    </Grid>
   </Grid>
  </Border>
  <local:SimpleStudioBar x:Name="SimpleTray" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="Collapsed"/>
 </Grid>
</UserControl>
