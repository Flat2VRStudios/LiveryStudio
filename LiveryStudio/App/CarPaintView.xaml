      <ToggleMenuFlyoutItem x:Name="FlatViewToggle" Text="Flat working view" Click="ToggleFlatView"/><MenuFlyoutSeparator/>
      <MenuFlyoutSubItem Text="Saved view 1"><MenuFlyoutItem Text="Save current view 1" Tag="0" Click="SaveCameraView"/><MenuFlyoutItem x:Name="RestoreCamera1" Text="Restore view 1" Tag="0" IsEnabled="False" Click="RestoreCameraView"/></MenuFlyoutSubItem>
      <MenuFlyoutSubItem Text="Saved view 2"><MenuFlyoutItem Text="Save current view 2" Tag="1" Click="SaveCameraView"/><MenuFlyoutItem x:Name="RestoreCamera2" Text="Restore view 2" Tag="1" IsEnabled="False" Click="RestoreCameraView"/></MenuFlyoutSubItem>
      <MenuFlyoutSubItem Text="Saved view 3"><MenuFlyoutItem Text="Save current view 3" Tag="2" Click="SaveCameraView"/><MenuFlyoutItem x:Name="RestoreCamera3" Text="Restore view 3" Tag="2" IsEnabled="False" Click="RestoreCameraView"/></MenuFlyoutSubItem>
      <MenuFlyoutSeparator/><MenuFlyoutItem Text="Export photo / turntable…" Click="ExportPresentation"/>
    </MenuFlyout></Button.Flyout></Button></StackPanel></Border>
