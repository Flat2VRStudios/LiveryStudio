    <Button Content="Fit car in view" Click="FitCar" HorizontalAlignment="Stretch"/>
    <TextBlock Text="WORKING ANGLES" FontSize="10" Foreground="{ThemeResource StudioAccentTextBrush}"/>
    <Grid ColumnSpacing="6" RowSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Button Content="Front" Tag="front" Click="Preset" HorizontalAlignment="Stretch"/><Button Content="Rear" Tag="rear" Click="Preset" Grid.Column="1" HorizontalAlignment="Stretch"/><Button Content="Left" Tag="left" Click="Preset" Grid.Row="1" HorizontalAlignment="Stretch"/><Button Content="Right" Tag="right" Click="Preset" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"/><Button Content="Top" Tag="top" Click="Preset" Grid.Row="2" HorizontalAlignment="Stretch"/><Button Content="Reset view" Tag="reset" Click="Preset" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"/></Grid>
