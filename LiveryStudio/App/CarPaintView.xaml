    <StackPanel x:Name="SurfaceBrushSettings" Visibility="Collapsed" Spacing="8"><TextBlock Text="Local gloss"/><Slider x:Name="BrushGloss" Minimum="0" Maximum="1" Value="0.65" StepFrequency="0.01" ValueChanged="SettingsChanged"/><TextBlock Text="Local metalness"/><Slider x:Name="BrushMetal" Minimum="0" Maximum="1" Value="0" StepFrequency="0.01" ValueChanged="SettingsChanged"/><TextBlock Text="Material strokes create textured surface masks. Paint in these areas uses your base color; its clear coat is replaced by the local finish." FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
    </StackPanel>
    <StackPanel x:Name="BrushColorSettings" Spacing="12" Visibility="Collapsed">
     <StackPanel x:Name="BeginnerColor" Spacing="8">
      <TextBlock Text="Brush color" FontWeight="SemiBold"/>
