    <Button x:Name="SampleBrushColor" Content="Pick a color from the car" Click="PickBrushFromCar" HorizontalAlignment="Stretch" ToolTipService.ToolTip="I · Samples design color without lighting, dirt or damage."/>
    </StackPanel>
