    <StackPanel Orientation="Horizontal" Spacing="5"><Button Content="Undo" Click="Undo" IsEnabled="{Binding ElementName=UndoButton,Path=IsEnabled}" Padding="10,6" FontSize="12"/><Button Content="Redo" Click="Redo" IsEnabled="{Binding ElementName=RedoButton,Path=IsEnabled}" Padding="10,6" FontSize="12"/><Button Content="Hold before" PointerPressed="SimpleComparePressed" PointerReleased="SimpleCompareReleased" PointerCaptureLost="SimpleCompareReleased" KeyDown="SimpleCompareKeyDown" KeyUp="SimpleCompareKeyUp" Padding="10,6" FontSize="12" AutomationProperties.Name="Hold to compare with original"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"><Button Content="Left" Tag="left" Click="Preset" Padding="8,6" FontSize="12"/><Button Content="Right" Tag="right" Click="Preset" Padding="8,6" FontSize="12"/><Button Content="Front" Tag="front" Click="Preset" Padding="8,6" FontSize="12"/><Button Content="Top" Tag="top" Click="Preset" Padding="8,6" FontSize="12"/><Button Content="Whole car" Tag="reset" Click="Preset" Padding="8,6" FontSize="12"/></StackPanel>
   </Grid>
   <TextBlock x:Name="SimpleCanvasStatus" Text="{Binding ElementName=CanvasStatus,Path=Text}" Visibility="Collapsed" Margin="14,51,14,0" VerticalAlignment="Top" FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
   <Border x:Name="SimpleSelectionActions" Visibility="Collapsed" Background="{ThemeResource StudioOverlayBrush}" CornerRadius="9" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="SimpleSelectionName" MaxWidth="145" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/><Button Content="Duplicate" Click="DuplicateLayer" Padding="9,6" FontSize="12"/><Button x:Name="SimpleSelectionRemove" Content="Remove" Click="RemoveLayer" Padding="9,6" FontSize="12"/><Button x:Name="SimpleSelectionOtherSide" Content="Both doors" Click="OtherSideArtwork" Padding="9,6" FontSize="12"/><Button x:Name="SimpleSelectionUnlock" Content="Unlock" Click="BeginnerUnlockArtwork" Padding="9,6" FontSize="12"/><Button x:Name="SimpleTrimPaint" Content="Remove paint spill" Click="TrimSimplePaint" Padding="9,6" FontSize="12"/></StackPanel></Border>
