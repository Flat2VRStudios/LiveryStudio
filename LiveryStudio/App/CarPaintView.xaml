       <Button Background="#FFFFFF" Tag="#FFFFFF" Click="BeginnerSwatch" AutomationProperties.Name="White brush" Height="34" HorizontalAlignment="Stretch"/>
       <Button Grid.Column="1" Background="#141414" Tag="#141414" Click="BeginnerSwatch" AutomationProperties.Name="Black brush" Height="34" HorizontalAlignment="Stretch"/>
       <Button Grid.Column="2" Background="#EF3946" Tag="#EF3946" Click="BeginnerSwatch" AutomationProperties.Name="Red brush" Height="34" HorizontalAlignment="Stretch"/>
       <Button Grid.Column="3" Background="#FFB511" Tag="#FFB511" Click="BeginnerSwatch" AutomationProperties.Name="Yellow brush" Height="34" HorizontalAlignment="Stretch"/>
       <Button Grid.Column="4" Background="#2E87F5" Tag="#2E87F5" Click="BeginnerSwatch" AutomationProperties.Name="Blue brush" Height="34" HorizontalAlignment="Stretch"/>
       <Button Grid.Column="5" Background="#21DCC1" Tag="#21DCC1" Click="BeginnerSwatch" AutomationProperties.Name="Mint brush" Height="34" HorizontalAlignment="Stretch"/>
      </Grid>
      <Button x:Name="BeginnerBrushColorButton" Click="BeginnerColorPicker" HorizontalAlignment="Stretch" AutomationProperties.Name="Choose brush color"><StackPanel Orientation="Horizontal" Spacing="10"><Rectangle x:Name="BeginnerBrushSwatch" Width="18" Height="18" Fill="#21DCC1" RadiusX="3" RadiusY="3"/><TextBlock Text="Choose brush color…"/></StackPanel></Button>
     </StackPanel>
    <Button x:Name="DesignColorsButton" Content="Design colors · link &amp; recolor" Click="ShowDesignColors" HorizontalAlignment="Stretch"/>
