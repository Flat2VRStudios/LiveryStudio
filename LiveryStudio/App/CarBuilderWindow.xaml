<Window x:Class="LiveryStudio.CarBuilderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LiveryStudio">
 <Grid x:Name="Root" Background="{ThemeResource StudioBackgroundBrush}" RequestedTheme="Dark" Padding="20,12,20,16" RowSpacing="12" SizeChanged="LayoutChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="12"><Image Source="Assets/AppIcon.png" Width="32" Height="32"/><StackPanel><TextBlock Text="CAR BUILDER" FontWeight="SemiBold" FontSize="20" CharacterSpacing="80"/><TextBlock x:Name="Subtitle" Text="A new exterior. A proven foundation." Foreground="{ThemeResource StudioSecondaryTextBrush}"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="CarModeButton" Content="Advanced mode" Click="ToggleCarMode"/><Button x:Name="OpenCarButton" Content="Open car" Click="OpenCar"/><Button x:Name="SaveCarButton" Content="Save car" Click="SaveCar"/></StackPanel></Grid>
  <StackPanel x:Name="Steps" Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button x:Name="ExteriorStep" Content="1  Exterior" Tag="0" Click="ChooseStep"/><Button x:Name="FitStep" Content="2  Fit" Tag="1" Click="ChooseStep"/><Button x:Name="PaintStep" Content="3  Paint" Tag="2" Click="ChooseStep"/><Button x:Name="DriveStep" Content="4  Drive" Tag="3" Click="ChooseStep"/></StackPanel>
  <Grid x:Name="Work" Grid.Row="2" ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsColumn" Width="292"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="CompactSettingsRow" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="SettingsCard" Background="{ThemeResource StudioCardBrush}" CornerRadius="12" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14">
    <StackPanel x:Name="ExteriorPanel" Spacing="12"><TextBlock Text="Build on a donor" FontSize="20" FontWeight="SemiBold"/><TextBox x:Name="CarName" Header="Car name" Text="Widebody Flight" TextChanged="NameChanged"/><ComboBox x:Name="Donor" Header="Donor car" HorizontalAlignment="Stretch" SelectionChanged="RecipeChanged"/><CheckBox x:Name="Interior" Content="Reuse donor interior" IsChecked="True" Checked="RecipeChanged" Unchecked="RecipeChanged"/><TextBlock Text="Donor wheels, tires, suspension, glass, lights and handling stay connected to the game." TextWrapping="Wrap" Foreground="{ThemeResource StudioSecondaryTextBrush}"/><Button x:Name="ImportExteriorButton" Content="Import exterior…" HorizontalAlignment="Stretch" Click="ImportExterior" Style="{StaticResource AccentButtonStyle}"/><Button Content="Try widebody example" HorizontalAlignment="Stretch" Click="Example"/><TextBlock x:Name="SourceLabel" Text="FBX · OBJ · GLB / static triangle meshes" TextWrapping="Wrap"/><TextBlock Text="The imported exterior uses your paint and artwork. Embedded material textures are not imported." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource StudioSecondaryTextBrush}"/></StackPanel>
    <StackPanel x:Name="FitPanel" Visibility="Collapsed" Spacing="12"><TextBlock Text="Make it fit" FontSize="20" FontWeight="SemiBold"/><CheckBox x:Name="AutoFit" Content="Fit to donor length" IsChecked="True" Checked="RecipeChanged" Unchecked="RecipeChanged"/><NumberBox x:Name="Width" Header="Width scale (%)" Value="100" Minimum="1" Maximum="10000" SmallChange="1" ValueChanged="FitChanged"/><NumberBox x:Name="Length" Header="Length scale (%)" Value="100" Minimum="1" Maximum="10000" SmallChange="1" ValueChanged="FitChanged"/><NumberBox x:Name="Height" Header="Height scale (%)" Value="100" Minimum="1" Maximum="10000" SmallChange="1" ValueChanged="FitChanged"/><NumberBox x:Name="Yaw" Header="Rotation (degrees)" Value="0" Minimum="-360" Maximum="360" SmallChange="90" ValueChanged="FitChanged"/><NumberBox x:Name="Side" Header="Side offset (m)" Value="0" Minimum="-20" Maximum="20" SmallChange="0.01" ValueChanged="FitChanged"/><NumberBox x:Name="Forward" Header="Forward offset (m)" Value="0" Minimum="-20" Maximum="20" SmallChange="0.01" ValueChanged="FitChanged"/><NumberBox x:Name="Up" Header="Height offset (m)" Value="0" Minimum="-20" Maximum="20" SmallChange="0.01" ValueChanged="FitChanged"/><Button Content="Update preview" HorizontalAlignment="Stretch" Click="UpdatePreview"/><TextBlock Text="Changing geometry starts a fresh paint surface. Your previous paint is kept as a recovery project." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource StudioSecondaryTextBrush}"/></StackPanel>
    <StackPanel x:Name="DrivePanel" Visibility="Collapsed" Spacing="12"><TextBlock Text="Take it to the track" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DriveIntro" Text="This test replaces the selected donor in your connected game. Your donor files are backed up first." TextWrapping="Wrap"/><TextBlock x:Name="CarGameStatus" TextWrapping="Wrap" Foreground="{ThemeResource StudioSecondaryTextBrush}"/><Expander Header="Choose another game installation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8"><TextBox x:Name="GameData" Header="Game installation" TextChanged="GameChanged"/><Button Content="Choose game folder" Click="PickGame"/></StackPanel></Expander><TextBlock x:Name="DriveHint" Text="Select the donor in Garage, then choose this car’s WK_ livery in Customize → Liveries." TextWrapping="Wrap"/><TextBlock x:Name="InstalledLabel" Text="No car installed by this session." TextWrapping="Wrap"/><Button x:Name="BuildButton" Content="Build &amp; install car" Click="BuildInstall" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="LaunchButton" Content="Launch game" Click="Launch" HorizontalAlignment="Stretch"/><Button x:Name="RestoreButton" Content="Restore original donor" Click="Restore" HorizontalAlignment="Stretch"/><TextBlock x:Name="DriveDetails" Text="The first release supports a rigid custom exterior with donor handling, collision and wheel rig. Custom panel detachment and new physics are not authored here." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource StudioSecondaryTextBrush}"/></StackPanel>
   </StackPanel></ScrollViewer></Border>
   <Grid x:Name="PreviewArea" Grid.Column="1"><local:CarPaintView x:Name="Painter" Visibility="Collapsed"/><Border x:Name="EmptyPreview" Background="{ThemeResource StudioCardBrush}" CornerRadius="16" Padding="32"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="420"><FontIcon Glyph="&#xE804;" FontSize="48" Foreground="{ThemeResource StudioAccentBrush}"/><TextBlock Text="Your next car starts here." FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Import an exterior, keep the donor parts that already work, then paint it in 3D." TextWrapping="Wrap" Foreground="{ThemeResource StudioSecondaryTextBrush}"/><TextBlock Text="Drag to orbit · scroll to zoom · right-drag while painting" TextWrapping="Wrap" FontSize="12"/></StackPanel></Border></Grid>
  </Grid>
  <InfoBar x:Name="Notice" Grid.Row="3" IsOpen="False" IsClosable="True"/>
  <Grid Grid.Row="4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock x:Name="Status" Text="Choose a donor and import an exterior." TextWrapping="Wrap" Foreground="{ThemeResource StudioSecondaryTextBrush}"/><ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Visibility="Collapsed" Click="Cancel"/><Button x:Name="NextButton" Grid.Column="1" Content="Next: fit" Click="Next"/></Grid>
 </Grid>
</Window>
