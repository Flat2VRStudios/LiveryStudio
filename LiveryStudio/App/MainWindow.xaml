<Window x:Class="LiveryStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LiveryStudio">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="{ThemeResource StudioBackgroundBrush}" SizeChanged="WindowLayoutChanged">
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="{ThemeResource StudioRailBrush}" Padding="24,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="Assets/AppIcon.png" Width="24" Height="24"/><TextBlock Text="LIVERY STUDIO" FontSize="12" FontWeight="SemiBold" CharacterSpacing="150"/><TextBlock Text="/  FLATOUT 4" FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}"/></StackPanel></Grid>
  <Grid x:Name="BodyLayout" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="NavigationRail" BorderBrush="{ThemeResource StudioBorderBrush}" BorderThickness="0,0,1,0" Padding="18,30" Background="{ThemeResource StudioRailBrush}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Spacing="8"><TextBlock x:Name="NavigationHeading" Text="YOUR WORKSHOP" Foreground="{ThemeResource StudioSecondaryTextBrush}" FontSize="10" CharacterSpacing="120" Margin="16,0,0,14"/>
      <Button x:Name="DesignNav" AutomationProperties.Name="Create livery" ToolTipService.ToolTip="Create livery" Style="{StaticResource NavButton}" Click="ShowDesign" Background="{ThemeResource StudioNavSelectedBrush}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE790;" FontSize="16"/><TextBlock x:Name="DesignNavLabel" Text="Create livery"/></StackPanel></Button>
      <Button x:Name="PaintNav" AutomationProperties.Name="3D paint studio" ToolTipService.ToolTip="3D paint studio" Style="{StaticResource NavButton}" Click="ShowPaint"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7C5;" FontSize="16"/><TextBlock x:Name="PaintNavLabel" Text="3D paint studio"/></StackPanel></Button>
      <Button x:Name="CarBuilderNav" AutomationProperties.Name="Car Builder" ToolTipService.ToolTip="Import a car exterior" Style="{StaticResource NavButton}" Click="ShowCarBuilder"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE804;" FontSize="16"/><TextBlock x:Name="CarBuilderLabel" Text="Car Builder"/></StackPanel></Button>
      <Button x:Name="LibraryNav" AutomationProperties.Name="Saved builds" ToolTipService.ToolTip="Saved builds" Style="{StaticResource NavButton}" Click="ShowLibrary"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="16"/><TextBlock x:Name="LibraryNavLabel" Text="Saved builds"/></StackPanel></Button>
      <Button x:Name="SetupNav" AutomationProperties.Name="Setup &amp; help" ToolTipService.ToolTip="Setup &amp; help" Style="{StaticResource NavButton}" Click="ShowSetup"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock x:Name="SetupNavLabel" Text="Setup &amp; help"/></StackPanel></Button>
     </StackPanel>
     <Border x:Name="NavigationPromo" Grid.Row="2" Background="{ThemeResource StudioElevatedBrush}" CornerRadius="12" Padding="16"><StackPanel Spacing="9"><Image Source="Assets/Theme/FlatOut4Logo.png" MaxWidth="150" Height="56" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="READY FOR THE TRACK" FontSize="10" Foreground="{ThemeResource StudioAccentTextBrush}" CharacterSpacing="80"/><TextBlock Text="Design. Bake. Drive." FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="27 cars. Your signature." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource StudioSecondaryTextBrush}"/></StackPanel></Border>
    </Grid>
   </Border>
   <Grid x:Name="ContentLayout" Grid.Column="1" Padding="32,26,32,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="PageHeading" Margin="0,0,0,20" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Style="{StaticResource StudioPageHeading}" Text="Make it yours." FontSize="32" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PageSubtitle" Text="Create a signature look. Take it straight to the track." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ToggleButton x:Name="AdvancedModeToggle" Content="Advanced mode" AutomationProperties.Name="Advanced mode" Click="EditorModeChanged" ToolTipService.ToolTip="Switch to Advanced mode for all tools and settings"/><Button x:Name="NewButton" AutomationProperties.Name="Design starters" ToolTipService.ToolTip="Start a new editable design" Click="StartDesign"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock x:Name="NewLabel" Text="Start a design"/></StackPanel></Button><Button AutomationProperties.Name="Settings" ToolTipService.ToolTip="Display quality and window layout"><FontIcon Glyph="&#xE8A9;" FontSize="14"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Display &amp; quality…" Click="ShowQualitySettings"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Compact window" Tag="compact" Click="ChooseWindowLayout"/><MenuFlyoutItem Text="Comfortable window" Tag="comfort" Click="ChooseWindowLayout"/><MenuFlyoutItem Text="Wide window" Tag="wide" Click="ChooseWindowLayout"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Maximize" Tag="max" Click="ChooseWindowLayout"/></MenuFlyout></Button.Flyout></Button><Button x:Name="OpenButton" AutomationProperties.Name="Open project" ToolTipService.ToolTip="Open an editable project; your current design is preserved as Previous draft" Click="OpenProject"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="14"/><TextBlock x:Name="OpenLabel" Text="Open project"/></StackPanel></Button><Button x:Name="SaveButton" AutomationProperties.Name="Save project" ToolTipService.ToolTip="Save a portable copy with textures, artwork and edit history. Your working draft saves automatically." Click="SaveProject"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="14"/><TextBlock x:Name="SaveLabel" Text="Save project"/></StackPanel></Button></StackPanel></Grid>
    <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,0,16"/>
    <Grid x:Name="DesignView" Grid.Row="2" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="FormColumn" Width="420"/></Grid.ColumnDefinitions>
     <ScrollViewer x:Name="DesignScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DesignCards" Spacing="18">
      <Border Style="{StaticResource Card}" Padding="0"><Grid MinHeight="270"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{ThemeResource StudioHeroStartColor}" Offset="0"/><GradientStop Color="{ThemeResource StudioHeroEndColor}" Offset="1"/></LinearGradientBrush></Grid.Background><StackPanel Margin="24" Spacing="12"><StackPanel Orientation="Horizontal" Spacing="8"><Border Background="{ThemeResource StudioBadgeBrush}" CornerRadius="5" Padding="8,4"><TextBlock Text="YOUR CANVAS" Foreground="{ThemeResource StudioAccentTextBrush}" FontSize="10" CharacterSpacing="70"/></Border><TextBlock Text="Reference vehicle" FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}" VerticalAlignment="Center"/></StackPanel><Image x:Name="CarImage" Height="175" Stretch="Uniform"/><TextBlock x:Name="CarTitle" Text="Grosse pointe" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="CarSubtitle" Text="Derby collection" Foreground="{ThemeResource StudioSecondaryTextBrush}" FontSize="12"/></StackPanel></Grid></Border>
      <Border Style="{StaticResource Card}" AllowDrop="True" DragOver="TextureDragOver" Drop="TextureDrop"><StackPanel Spacing="14"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Texture studio" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Use car templates" HorizontalAlignment="Right" Click="UseTemplates" ToolTipService.ToolTip="Start with this car’s original maps; restore your last design from Previous draft" FontSize="12" Padding="10,5"/></Grid><TextBlock Text="Choose a full texture map, or drop a PNG or TGA onto its tile. To place a sticker, use the 3D paint studio." Style="{StaticResource Label}" TextWrapping="Wrap"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" Click="PickAlbedo" Tag="color" AllowDrop="True" DragOver="TextureDragOver" Drop="TextureDrop" ToolTipService.ToolTip="Replace the full color map. Your last editable design is kept in Previous draft."><StackPanel Spacing="8"><Image x:Name="AlbedoPreview" Height="105" Stretch="Uniform"/><TextBlock Text="Albedo / color" FontWeight="SemiBold"/><TextBlock x:Name="AlbedoName" Text="Choose texture" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource StudioSecondaryTextBrush}"/></StackPanel></Button>
       <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" Click="PickStructure" Tag="surface" AllowDrop="True" DragOver="TextureDragOver" Drop="TextureDrop" ToolTipService.ToolTip="Replace the surface map. Your last editable design is kept in Previous draft."><StackPanel Spacing="8"><Image x:Name="StructurePreview" Height="105" Stretch="Uniform"/><TextBlock Text="Structure / surface" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock x:Name="StructureName" Text="Choose texture" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource StudioSecondaryTextBrush}"/></StackPanel></Button>
      </Grid><TextBlock Text="Albedo alpha controls the paint mask. Structure RGB controls gloss, metalness, and special surface masks." Foreground="{ThemeResource StudioSecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Paint palette" FontSize="18" FontWeight="SemiBold"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="OuterSwatch" Height="56" CornerRadius="8" Background="{ThemeResource StudioAccentBrush}"><TextBlock x:Name="OuterSwatchLabel" Text="EDGE COLOR" Foreground="Black" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><Border x:Name="InnerSwatch" Grid.Column="1" Height="56" CornerRadius="8" Background="#123543"><TextBlock x:Name="InnerSwatchLabel" Text="FACE COLOR" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></Grid><TextBlock Text="Orbit the actual car in the 3D paint studio to inspect color, surface finish and reflections." Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="FormScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Form" Spacing="20">
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><TextBlock Text="01  /  Identity" FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="LiveryName" Header="Livery name" Text="Midnight Current" MaxLength="100" TextChanged="DraftChanged"/><ComboBox x:Name="CarSelector" Header="Choose your car" DisplayMemberPath="Display" HorizontalAlignment="Stretch" SelectionChanged="CarChanged" IsTextSearchEnabled="True" ToolTipService.ToolTip="Changing cars starts with that car’s templates. Your last design is preserved in Previous draft."/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><TextBlock Text="02  /  The finish" FontSize="18" FontWeight="SemiBold"/><ComboBox x:Name="FinishSelector" Header="Finish preset" DisplayMemberPath="Name" PlaceholderText="Custom finish" HorizontalAlignment="Stretch" SelectionChanged="FinishPresetChanged"/><TextBlock Text="{Binding ElementName=FinishSelector,Path=SelectedItem.Description}" Style="{StaticResource Label}" TextWrapping="Wrap"/><ToggleSwitch x:Name="ColorMode" Header="Paint color mode" OnContent="Match the color picker" OffContent="Original Workshop colors" Toggled="MaterialToggleChanged"/><TextBlock Text="Older Workshop projects use brighter paint colors. The preview now shows that same interpretation." FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}" TextWrapping="Wrap"/><Button Content="Swap edge and face colors" Click="SwapPaintColors"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OuterHex" Header="Outer paint color" Text="#21DCC1" TextChanged="DraftChanged" MaxLength="7"/><Button Grid.Column="1" Content="Pick" Tag="outer" Click="PickPaintColor" VerticalAlignment="Bottom" AutomationProperties.Name="Choose edge paint color"/></Grid><Grid><TextBlock Text="Edge gloss" Style="{StaticResource Label}"/><TextBlock Text="{Binding ElementName=OuterGloss,Path=Value,Converter={StaticResource Percent}}" HorizontalAlignment="Right" Foreground="{ThemeResource StudioAccentTextBrush}"/></Grid><Slider x:Name="OuterGloss" Minimum="0" Maximum="1" Value="0.85" StepFrequency="0.01" ValueChanged="FinishChanged"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="InnerHex" Header="Inner paint color" Text="#123543" TextChanged="DraftChanged" MaxLength="7"/><Button Grid.Column="1" Content="Pick" Tag="inner" Click="PickPaintColor" VerticalAlignment="Bottom" AutomationProperties.Name="Choose face paint color"/></Grid><Grid><TextBlock Text="Face gloss" Style="{StaticResource Label}"/><TextBlock Text="{Binding ElementName=InnerGloss,Path=Value,Converter={StaticResource Percent}}" HorizontalAlignment="Right" Foreground="{ThemeResource StudioAccentTextBrush}"/></Grid><Slider x:Name="InnerGloss" Minimum="0" Maximum="1" Value="0.65" StepFrequency="0.01" ValueChanged="FinishChanged"/><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Grid><TextBlock Text="Metalness" Style="{StaticResource Label}"/><TextBlock Text="{Binding ElementName=Metalness,Path=Value,Converter={StaticResource Percent}}" HorizontalAlignment="Right" Foreground="{ThemeResource StudioAccentTextBrush}"/></Grid><Slider x:Name="Metalness" Minimum="0" Maximum="1" Value="0.8" StepFrequency="0.01" ValueChanged="FinishChanged"/></StackPanel><StackPanel Grid.Column="1"><Grid><TextBlock Text="Clear coat" Style="{StaticResource Label}"/><TextBlock Text="{Binding ElementName=ClearCoat,Path=Value,Converter={StaticResource Percent}}" HorizontalAlignment="Right" Foreground="{ThemeResource StudioAccentTextBrush}"/></Grid><Slider x:Name="ClearCoat" Minimum="0" Maximum="1" Value="0.9" StepFrequency="0.01" ValueChanged="FinishChanged"/></StackPanel></Grid></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><TextBlock Text="Textured panels &amp; decals" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold"/><ToggleSwitch x:Name="ArtworkOverride" Header="Customize their finish" OnContent="Use the finish below" OffContent="Keep the structure map" Toggled="MaterialToggleChanged"/><StackPanel x:Name="ArtworkSettings" Spacing="8"><TextBlock Text="Artwork gloss" Style="{StaticResource Label}"/><Slider x:Name="ArtworkGloss" Minimum="0" Maximum="1" Value="0.65" StepFrequency="0.01" ValueChanged="FinishChanged"/><TextBlock Text="Artwork metalness" Style="{StaticResource Label}"/><Slider x:Name="ArtworkMetalness" Minimum="0" Maximum="1" Value="0" StepFrequency="0.01" ValueChanged="FinishChanged"/></StackPanel><TextBlock Text="The app creates the matching structure texture at bake time. Your source map stays untouched." FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}"><Expander Header="Damage finish" HorizontalAlignment="Stretch"><StackPanel Spacing="10"><TextBlock Text="Gloss and metalness of newly exposed damage. Clear coat is removed by the game as the car is damaged." TextWrapping="Wrap" Style="{StaticResource Label}"/><TextBlock Text="Exposed metal gloss" Style="{StaticResource Label}"/><Slider x:Name="DamageGloss" Minimum="0" Maximum="1" Value="1" StepFrequency="0.01" ValueChanged="FinishChanged"/><TextBlock Text="Damage metalness" Style="{StaticResource Label}"/><Slider x:Name="DamageMetalness" Minimum="0" Maximum="1" Value="0.784314" StepFrequency="0.01" ValueChanged="FinishChanged"/></StackPanel></Expander></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="14"><TextBlock Text="03  /  Workshop details" FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="Description" Header="Description" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="95" TextChanged="DraftChanged"/><Button Content="Choose banner" HorizontalAlignment="Stretch" Click="PickBanner"/><Image x:Name="BannerPreview" Height="90" Stretch="Uniform"/><TextBlock x:Name="BannerName" Text="256 × 256 recommended for Steam Workshop" Style="{StaticResource Label}" TextWrapping="Wrap"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
    <Grid x:Name="PaintWorkspace" Grid.Row="2" Visibility="Collapsed" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="PaintCarSelector" DisplayMemberPath="Display" HorizontalAlignment="Stretch" MinWidth="0" AutomationProperties.Name="Preview car" SelectionChanged="PaintCarChanged" ToolTipService.ToolTip="Change to a new car with its original maps. Your last design is preserved in Previous draft."/><Button x:Name="SimpleCarButton" Click="OpenSimpleCarPicker" AutomationProperties.Name="Choose a car" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="12"><Image x:Name="SimpleCarImage" Width="64" Height="34" Stretch="Uniform"/><TextBlock x:Name="SimpleCarName" VerticalAlignment="Center"/><TextBlock Text="Choose car" FontSize="12" Foreground="{ThemeResource StudioSecondaryTextBrush}" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="DesignSettingsButton" Grid.Column="1" Content="Finish &amp; texture settings" Click="ShowDesign" ToolTipService.ToolTip="Finish &amp; texture settings"/></Grid><local:CarPaintView x:Name="Painter" Grid.Row="1"/></Grid>
    <Grid x:Name="LibraryView" Grid.Row="2" Visibility="Collapsed" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BuildSearch" PlaceholderText="Find a build by name or car" AutomationProperties.Name="Search saved builds" TextChanged="BuildSearchChanged"/><Button x:Name="RefreshBuildsButton" Grid.Column="1" Content="Refresh" Click="RefreshBuildsClick"/></Grid>
     <TextBlock x:Name="LibraryStatus" Grid.Row="1" Text="Loading saved builds…" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap"/>
     <ListView x:Name="BuildList" Grid.Row="2" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="BuildSelected" AutomationProperties.Name="Saved livery builds"><ListView.ItemTemplate><DataTemplate><Grid Padding="12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{ThemeResource StudioElevatedBrush}" CornerRadius="8"><Image Source="{Binding CarImage}" Height="66" Stretch="Uniform" ToolTipService.ToolTip="Reference vehicle"/></Border><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Car}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource StudioAccentTextBrush}"/><TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Detail}" FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
     <Border Grid.Row="3" Background="{ThemeResource StudioCardBrush}" CornerRadius="8" Padding="12,8"><StackPanel Spacing="4"><TextBlock x:Name="LibrarySelectionTitle" Text="Choose a saved build" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="LibrarySelectionHint" Text="Browse freely. Your current design stays open until you choose an editable copy." FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel></Border>
    </Grid>
    <ScrollViewer x:Name="SetupView" Grid.Row="2" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="20" MaxWidth="800" HorizontalAlignment="Stretch">
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="14">
            <TextBlock Text="FlatOut 4" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="GameDetectionTitle" Text="Finding FlatOut 4…" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="GameDetectionDetail" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="LaunchGameButton" Content="Launch FlatOut 4" Click="LaunchGame" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/>
              <Button x:Name="SteamWorkshopButton" Content="Steam Workshop" Click="OpenSteamWorkshop" Visibility="Collapsed"/>
            </StackPanel>
            <Expander Header="Choose a different installation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock x:Name="GameLocation" Style="{StaticResource Label}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                <TextBlock Text="The Steam installation is found automatically. If yours is elsewhere, choose its installation folder." Style="{StaticResource Label}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="FindGameButton" Content="Find game again" Click="FindGameAgain"/>
                  <Button x:Name="ChooseGameButton" Content="Choose game folder…" Click="PickGame"/>
                </StackPanel>
              </StackPanel>
            </Expander>
            <TextBox x:Name="GameFolder" Visibility="Collapsed" TextChanged="GameFolderChanged"/>
          </StackPanel>
        </Border>
        <TextBlock Text="All 27 cars and the tools to build your liveries are included. No extra setup is needed to create." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="4,0"/>
        <Border x:Name="InstalledImportsCard" Style="{StaticResource Card}" Visibility="Collapsed">
          <StackPanel Spacing="14">
            <TextBlock Text="Installed liveries" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="InstalledStatus" TextWrapping="Wrap" Style="{StaticResource Label}"/>
            <Button x:Name="InstalledRefreshButton" Content="Refresh installed liveries" Click="RefreshInstalledClick"/>
            <ListView x:Name="InstalledList" SelectionChanged="InstalledSelectionChanged" MaxHeight="240" HorizontalContentAlignment="Stretch">
              <ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Receipt.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Foreground="{ThemeResource StudioAccentTextBrush}"/><TextBlock Text="{Binding Receipt.Key}" FontSize="11" Foreground="{ThemeResource StudioSecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="InstalledSelectionHint" TextWrapping="Wrap" Style="{StaticResource Label}" FontSize="12"/>
            <Button x:Name="InstalledUpdateButton" IsEnabled="False" Content="Bake draft &amp; update selected import" Click="UpdateInstalled" HorizontalAlignment="Stretch"/>
            <Button x:Name="InstalledRemoveButton" IsEnabled="False" Content="Remove selected import" Click="RemoveInstalled" HorizontalAlignment="Stretch"/>
            <CheckBox x:Name="ReplaceOnTest" Content="Update the selected installation when testing"/>
            <TextBlock Text="Drive it builds and imports your livery, then launches the game in desktop mode. Your original settings are backed up. A running game closes normally after you confirm." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource StudioSecondaryTextBrush}"/>
          </StackPanel>
        </Border>
        <Expander Header="Texture guide &amp; manual" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="12">
            <TextBlock Text="Albedo: RGB is surface color. Alpha black applies car paint; alpha white shows the texture.&#10;&#10;Structure: red controls gloss, green controls metalness, and blue carries special surface / wiper masks.&#10;&#10;Paint: outer is the edge color; inner is the base color. Every finish control ranges from 0 to 1." TextWrapping="Wrap" Style="{StaticResource Label}"/>
            <Button Content="Open Workshop manual" Click="OpenManual"/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
  <Border x:Name="Footer" Grid.Row="2" BorderBrush="{ThemeResource StudioElevatedBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource StudioRailBrush}" Padding="24,8"><Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Start with a car and two texture maps." FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding ElementName=Status,Path=Text}"/><ProgressBar x:Name="BuildProgress" Grid.Column="1" Visibility="Collapsed" Width="100" Maximum="100" VerticalAlignment="Center"/><Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" AutomationProperties.Name="Cancel build" Visibility="Collapsed" Click="CancelBuild" Padding="8,3" FontSize="11"/></Grid><Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CommandBar x:Name="OutputCommands" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" HorizontalContentAlignment="Right"><AppBarButton x:Name="ExportButton" Icon="Save" Label="Export package" DynamicOverflowOrder="1" IsEnabled="False" Click="ExportPackage"/><AppBarButton x:Name="PublishButton" Icon="Upload" Label="Publish to Steam" DynamicOverflowOrder="2" IsEnabled="False" Click="Publish"/><AppBarButton x:Name="ImportButton" Icon="Download" Label="Import to game" DynamicOverflowOrder="3" IsEnabled="False" Click="ImportToGame"/><CommandBar.SecondaryCommands><AppBarButton Icon="Undo" Label="Recover a draft" Click="RecoverDraft"/><AppBarButton x:Name="PreviousDraftButton" Icon="Undo" Label="Previous draft" IsEnabled="False" Click="OpenPreviousDraft"/><AppBarButton x:Name="TestGameButton" Icon="Play" Label="Test in game · bake + import + launch" Click="TestInGame"/><AppBarButton x:Name="LogButton" Icon="Document" Label="Build log" Click="ShowLog"/></CommandBar.SecondaryCommands></CommandBar><CommandBar x:Name="LibraryOutputCommands" Visibility="Collapsed" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" HorizontalContentAlignment="Right"><AppBarButton x:Name="LibraryExportButton" Icon="Save" Label="Export package" DynamicOverflowOrder="1" IsEnabled="False" Click="ExportPackage"/><AppBarButton x:Name="LibraryImportButton" Icon="Download" Label="Import to game" DynamicOverflowOrder="2" IsEnabled="False" Click="ImportToGame"/><CommandBar.SecondaryCommands><AppBarButton x:Name="LibraryPublishButton" Icon="Upload" Label="Publish to Steam" IsEnabled="False" Click="Publish"/><AppBarButton Icon="Undo" Label="Recover a draft" Click="RecoverDraft"/><AppBarButton Icon="Document" Label="Selected build log" Click="ShowLog"/></CommandBar.SecondaryCommands></CommandBar><Button x:Name="OpenSavedBuildButton" Grid.Column="1" Content="Open editable copy" Style="{StaticResource AccentButtonStyle}" Padding="18,11" Visibility="Collapsed" IsEnabled="False" Click="OpenSelectedBuild"/><Button x:Name="BakeButton" Grid.Column="1" Content="Bake livery" Style="{StaticResource AccentButtonStyle}" Padding="24,11" VerticalAlignment="Center" Click="Bake"/></Grid></Grid></Border>
 </Grid>
</Window>
