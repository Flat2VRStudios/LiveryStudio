<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../App/ImageFiles.cs" Link="ImageFiles.cs" />
    <Compile Include="../App/PhotoEncoding.cs" Link="PhotoEncoding.cs" />
    <ProjectReference Include="../Core/LiveryStudio.Core.csproj" Condition="'$(ImageFileCoreAssembly)' == ''" />
    <Reference Include="LiveryStudio.Core" Condition="'$(ImageFileCoreAssembly)' != ''"><HintPath>$(ImageFileCoreAssembly)</HintPath></Reference>
  </ItemGroup>
</Project>
