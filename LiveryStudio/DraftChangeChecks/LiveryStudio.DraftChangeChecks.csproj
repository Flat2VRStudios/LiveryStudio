<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DraftChangeCoreProject Condition="'$(DraftChangeCoreProject)' == ''">../Core/LiveryStudio.Core.csproj</DraftChangeCoreProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../App/DraftChanges.cs" Link="DraftChanges.cs" />
    <Compile Include="../App/TextureImports.cs" Link="TextureImports.cs" />
    <Compile Include="../App/DraftRecovery.cs" Link="DraftRecovery.cs" />
    <ProjectReference Include="$(DraftChangeCoreProject)" />
  </ItemGroup>
</Project>
